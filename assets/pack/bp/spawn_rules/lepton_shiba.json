{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": { "identifier": "lepton:shiba", "population_control": "animal" },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:grass_block", "minecraft:snow_layer", "minecraft:snow"],
        "minecraft:brightness_filter": { "min": 9, "max": 15, "adjust_for_weather": false },
        "minecraft:weight": { "default": 40 },
        "minecraft:herd": { "min_size": 1, "max_size": 3 },
        "minecraft:biome_filter": { "any_of": [{ "test": "has_biome_tag", "value": "mountains" }] }
      }
    ]
  }
}
