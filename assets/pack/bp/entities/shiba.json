      "minecraft:leashable": { "soft_distance": 4.0, "hard_distance": 6.0, "max_distance": 10.0 },
      "minecraft:nameable": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:equipment": { "slot_drop_chance": [{ "slot": "slot.weapon.mainhand", "drop_chance": 0.0 }] },
      "minecraft:behavior.float": { "priority": 1 },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [{ "filters": { "test": "in_lava", "subject": "self", "value": true }, "cause": "lava", "damage_per_tick": 4 }]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": ["lepton:adult", "lepton:wild", "lepton:wander"] } },
          {
            "randomize": [
              { "weight": 199, "add": { "component_groups": ["lepton:coat_0"] } },
              { "weight": 199, "add": { "component_groups": ["lepton:coat_1"] } },
              { "weight": 199, "add": { "component_groups": ["lepton:coat_2"] } },
              { "weight": 3, "add": { "component_groups": ["lepton:coat_3"] } }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          { "add": { "component_groups": ["lepton:baby", "lepton:tame", "lepton:wander"] } },
          {
            "randomize": [
              { "weight": 199, "add": { "component_groups": ["lepton:coat_0"] } },
              { "weight": 199, "add": { "component_groups": ["lepton:coat_1"] } },
              { "weight": 199, "add": { "component_groups": ["lepton:coat_2"] } },
              { "weight": 3, "add": { "component_groups": ["lepton:coat_3"] } }
            ]
          }
        ]
      },
      "minecraft:ageable_grow_up": {
        "remove": { "component_groups": ["lepton:baby"] },
        "add": { "component_groups": ["lepton:adult"] }
      },
      "lepton:on_tame": { "remove": { "component_groups": ["lepton:wild"] }, "add": { "component_groups": ["lepton:tame"] } },
      "lepton:untame": { "remove": { "component_groups": ["lepton:tame"] }, "add": { "component_groups": ["lepton:wild"] } },
      "lepton:busy": { "remove": { "component_groups": ["lepton:wander"] } },
      "lepton:idle": { "add": { "component_groups": ["lepton:wander"] } },
      "lepton:armor_on": { "set_property": { "lepton:armor": true } },
      "lepton:armor_off": { "set_property": { "lepton:armor": false } }
    }
  }
