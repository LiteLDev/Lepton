          "tame_items": "bone",
          "tame_event": { "event": "lepton:on_tame", "target": "self" }
        }
      },
      "lepton:tame": {
        "minecraft:is_tamed": {},
        "minecraft:health": { "value": 20, "max": 20 },
        "minecraft:sittable": {},
