        "minecraft:breedable": {
          "require_tame": true,
          "inherit_tamed": true,
          "breed_items": ["beef", "chicken", "cooked_beef", "cooked_chicken", "cooked_mutton", "cooked_porkchop", "cooked_rabbit", "mutton", "porkchop", "rabbit", "rotten_flesh"],
          "breeds_with": {
