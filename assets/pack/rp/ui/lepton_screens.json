{
  "namespace": "lepton",

  "custom_screen_content": {
    "type": "panel",
    "size": ["100%", "100%"]
  },

  "custom_screen@common.base_screen": {
    "$screen_content": "lepton.custom_screen_content",
    "is_showing_menu": true,
    "should_steal_mouse": false,
    "render_game_behind": true,
    "absorbs_input": true,
    "close_on_player_hurt": true
  }
}
