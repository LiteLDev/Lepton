        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "v.lp_skin > 0 ? Array.lepton[(v.lp_skin == 31 ? 0 : v.lp_skin)] : Texture.default"
      ],
      "ignore_lighting": true,
      "arrays": {
        "textures": {
          "Array.lepton": [
            "Texture.lp_shiny",
