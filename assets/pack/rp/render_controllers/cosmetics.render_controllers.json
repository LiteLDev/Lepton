{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.lepton.cow": {
      "arrays": {
        "textures": {
          "Array.textures": [
            "Texture.default",
            "Texture.warm",
            "Texture.cold"
          ],
          "Array.baby_textures": [
            "Texture.baby_default",
            "Texture.baby_warm",
            "Texture.baby_cold"
          ],
          "Array.lepton": [
            "Texture.lp_shiny",
            "Texture.lp_1",
            "Texture.lp_2",
            "Texture.lp_3",
            "Texture.lp_4"
          ]
        },
        "geometries": {
          "Array.geos": [
            "Geometry.default",
            "Geometry.warm",
            "Geometry.cold"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.baby : Array.geos[v.index]",
      "materials": [
        {
          "*": "v.is_cold ? Material.cold : Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Array.baby_textures[v.index] : ((v.index == 0 && v.lp_skin > 0) ? Array.lepton[(v.lp_skin == 31 ? 0 : v.lp_skin)] : Array.textures[v.index])"
      ]
    },
    "controller.render.lepton.pig": {
      "arrays": {
        "textures": {
          "Array.default": [
            "Texture.default",
            "Texture.warm",
            "Texture.cold"
          ],
          "Array.baby": [
            "Texture.baby_default",
            "Texture.baby_warm",
            "Texture.baby_cold"
          ],
          "Array.lepton": [
            "Texture.lp_shiny",
            "Texture.lp_1",
            "Texture.lp_2",
            "Texture.lp_3"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Array.baby[v.index] : ((v.index == 0 && v.lp_skin > 0) ? Array.lepton[(v.lp_skin == 31 ? 0 : v.lp_skin)] : Array.default[v.index])"
      ]
    },
    "controller.render.lepton.chicken": {
