        "coefficient_of_restitution": 0,
        "collision_drag": 10
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 * (variable.particle_random_3 * 0.5 + 0.5)",
          "0.1 * (variable.particle_random_3 * 0.5 + 0.5)"
        ],
